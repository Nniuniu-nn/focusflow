# FocusFlow 环境变量模板。
# 复制为 .env 并填入真实值。.env 已在 .gitignore 中，不会入库。
#
# 这些变量由 src/env.ts 读取并在启动时校验：缺任何一项、或 JWT_SECRET 短于
# 32 字符，进程会直接拒绝启动（fail fast），而不是带着半个配置跑到运行时才炸。

# MySQL 连接串。密码里若含 @ : / ? # 等字符需要 URL 编码，
# 否则会被当成连接串的分隔符解析出错误的主机名。
DATABASE_URL="mysql://root:你的密码@localhost:3306/focusflow"

# HTTP 监听端口。app.listen 用的就是它，默认 3000。
PORT=3000

# development 时 cookie 的 secure 标志会关掉（否则本地 http 下发不出 cookie）；
# 生产环境设为其它值时 secure 打开，cookie 只在 HTTPS 上传输。
NODE_ENV=development

# 集成测试用独立数据库，避免污染开发数据。复制为 .env.test 使用。
# ★ 必须与开发库分开：tests/helpers/server.ts 会断言库名以 _test 结尾，
#   连到开发库上会直接拒绝运行（防止测试把真实数据清空）。
# DATABASE_URL="mysql://root:你的密码@localhost:3306/focusflow_test"

# JWT 签名密钥。用 `openssl rand -base64 32` 生成，至少 32 字符。
# 缺失或过短时服务会拒绝启动 —— 带默认值的签名密钥等于没有密钥。
JWT_SECRET="请替换成你自己的随机密钥，至少32个字符"
